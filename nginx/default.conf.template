server {
  listen 11434;

  # Only the OpenAI-compatible API. Blocks /api/pull, /api/delete, /api/create.
  location /v1/ {
    proxy_pass ${OLLAMA_UPSTREAM};
    proxy_set_header Host 127.0.0.1:11434;
    proxy_http_version 1.1;
    proxy_buffering off;          # stream tokens
    proxy_read_timeout 600s;
  }

  location / {
    return 403;
  }
}
